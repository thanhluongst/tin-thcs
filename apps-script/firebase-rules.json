{
  "rules": {
    ".read": false,
    ".write": false,
    "tin": {
      "$bai": {
        "$buoi": {
          ".read": true,
          "nop": {
            ".write": true,
            ".validate": "newData.isNumber()"
          },
          "rev": {
            ".write": true,
            ".validate": "newData.hasChildren(['t', 'rev']) && newData.child('t').isNumber()"
          },
          "hs": {
            "$may": {
              ".write": true,
              ".validate": "$may.length < 40 && newData.hasChildren(['t', 'nx']) && newData.child('t').isNumber()"
            }
          },
          "$khac": {
            ".validate": false
          }
        }
      }
    },
    "xh": {
      "$bai": {
        "$lop": {
          ".read": true,
          "$hs": {
            ".write": true,
            ".validate": "$hs.length < 40 && newData.hasChildren(['n', 'd', 't']) && newData.child('d').isNumber() && newData.child('d').val() < 100000 && newData.child('n').isString() && newData.child('n').val().length <= 40"
          }
        }
      }
    }
  }
}